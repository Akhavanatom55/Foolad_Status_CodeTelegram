<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/exammonitor/db" VERSION="2026092500" COMMENT="XMLDB file for local_exammonitor plugin"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
    <TABLES>
        <TABLE NAME="exammonitor_log" COMMENT="Successful Excel/XML imports performed by Exam Monitor.">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key."/>
                <FIELD NAME="quizid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Quiz instance id."/>
                <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Course id."/>
                <FIELD NAME="contenthash" TYPE="char" LENGTH="64" NOTNULL="true" COMMENT="content hash of imported XML content."/>
                <FIELD NAME="filename" TYPE="char" LENGTH="255" NOTNULL="true" COMMENT="Original uploaded XML filename."/>
                <FIELD NAME="questioncount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Number of questions imported."/>
                <FIELD NAME="addedcount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" COMMENT="Number of questions added to quiz."/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Moodle user who initiated the import."/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="Unix timestamp."/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="quiz_hash" UNIQUE="false" FIELDS="quizid, contenthash"/>
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>
